APP_NAME=Tourvaa Backend
APP_ENV=development
APP_DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/tourvaa_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-random-hex-secret-here
ADMIN_JWT_SECRET_KEY=generate-a-different-64-character-hex-secret
NORMAL_JWT_SECRET_KEY=generate-another-different-64-character-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ─── App URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MOBILE_DEEP_LINK_URL=tourvaa://reset-password

# Google OAuth (use the matching production URLs in Vercel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ROOT=storage

# ─── Cloudinary (file/image storage + CDN) ────────────────────────────────────
# Get this from https://console.cloudinary.com/settings/c-.../api-keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Public tour and CMS assets only. Private supplier/vehicle/agent/affiliate
# documents always use authenticated Cloudinary folders instead.
CLOUDINARY_PUBLIC_ROOT=tourvaa_demo/public

# ─── Super Admin ──────────────────────────────────────────────────────────────
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_RESET_PASSWORD_ON_STARTUP=false

# ─── Admin / Sub Admin bootstrap logins ──────────────────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin.user@example.com
ADMIN_PASSWORD=ChangeAdmin@123
ADMIN_RESET_PASSWORD_ON_STARTUP=false

SUB_ADMIN_NAME=Sub Admin
SUB_ADMIN_EMAIL=subadmin@example.com
SUB_ADMIN_PASSWORD=ChangeSubAdmin@123
SUB_ADMIN_RESET_PASSWORD_ON_STARTUP=false

# ─── Email Verification ───────────────────────────────────────────────────────
# Required for CUSTOMER, AGENT, and SUPPLIER public registration.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Tourvaa
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_REPLY_TO=support@example.com
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=20

# ─── Chatbot (RAG, no external LLM / API key) ─────────────────────────────────
# Answers are retrieved from FAQs, Help Centre, CMS pages and published tours.
# Local embedding model for RAG retrieval (runs on CPU, no API key required).
# Uncomment to override the default (BAAI/bge-small-en-v1.5).
# CHATBOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Geo API ──────────────────────────────────────────────────────────────────
# Get free key from https://countrystatecity.in

# ─── GeoIP (browsing-currency detection only, never checkout-critical) ────────
# Provider used to map a visitor's IP to a country for currency/locale
# defaults. "ip-api" (default) is ip-api.com; its free/no-key tier is NOT
# licensed for commercial production use, so set GEOIP_API_KEY for a paid
# plan, or switch GEOIP_PROVIDER to "ipapi" (ipapi.com) with its own key.
# Lookups always fail open to DEFAULT_CURRENCY/DEFAULT_LOCALE below.
GEOIP_PROVIDER=ip-api
GEOIP_API_KEY=
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US

# ─── Viator Partner API (Basic Access) ────────────────────────────────────────
# Powers "Day Tours & Experiences" (/day-tours). Backend-only - never put these
# in the frontend or under NEXT_PUBLIC_. The key/PID can also be saved
# (encrypted) from Admin -> Settings -> API; the admin value wins over .env.
# exp-api-key from the Viator Partner dashboard -> Settings -> API Keys.
VIATOR_API_KEY=
# Your Partner ID (P + 8 digits). VIATOR_AFFILIATE_PID is the older name.
VIATOR_PID=
VIATOR_AFFILIATE_PID=
# sandbox -> https://api.sandbox.viator.com/partner
# production -> https://api.viator.com/partner (needs a production key)
VIATOR_ENV=sandbox
# Optional explicit base URL override (normally leave blank).
VIATOR_API_BASE_URL=
# Deployment kill switch (the admin Enable toggle must also be on).
VIATOR_ENABLED=true
# Affiliate links get campaign=<prefix>-<page>, e.g. tourvaa-day-tours.
VIATOR_CAMPAIGN_PREFIX=tourvaa
VIATOR_TIMEOUT_SECONDS=15

# ─── Stripe ───────────────────────────────────────────────────────────────────
# After filling these, run: python seed.py to store them encrypted in DB
# STRIPE_WEBHOOK_SECRET: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── PayPal ───────────────────────────────────────────────────────────────────
# After filling these, run: python seed.py
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` or `live`. This value is imported into the encrypted database
# gateway setting by `python seed.py`; runtime checkout reads that DB setting.
PAYPAL_MODE=sandbox
# PayPal Dashboard webhook ID for this API's /api/payments/paypal/webhook URL.
# Required in production for signature verification.
PAYPAL_WEBHOOK_ID=

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER change this after first use - existing encrypted DB values will break.
SETTINGS_ENCRYPTION_KEY=your-random-hex-64-chars

# ─── Redis (optional, required for WEB_CONCURRENCY > 1) ───────────────────────
# Leave blank for a single worker/instance: rate limiting, scheduled-sweep
# locking, and /ws/messages realtime delivery all fall back to in-process
# state, which is only correct with exactly one worker and one instance.
# Set this to a real shared Redis instance to run WEB_CONCURRENCY > 1 or to
# deploy more than one instance - app.main.validate_worker_concurrency()
# refuses to start otherwise.
REDIS_URL=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=vapid_private.pem
VAPID_MAILTO=mailto:your@email.com

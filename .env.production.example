# ==============================================================================
# TOURVAA PRODUCTION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.production.example
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.production on your production server.
# 2. Never commit .env or .env.production to version control.
# 3. Generate all secrets using strong cryptographic randomness:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# ─── Core Application Settings ────────────────────────────────────────────────
APP_NAME=Tourvaa Platform
APP_ENV=production
APP_DEBUG=false

# ─── Production Database Cluster ──────────────────────────────────────────────
# Use a production-grade MySQL 8.0+ or Amazon RDS / Cloud SQL cluster.
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://tourvaa_prod_user:CHANGE_TO_STRONG_PASSWORD@prod-mysql.internal:3306/tourvaa_prod?charset=utf8mb4

# ─── Cryptographic Secrets (MANDATORY IN PRODUCTION) ──────────────────────────
# Generate each secret separately with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_1
ADMIN_JWT_SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_2
NORMAL_JWT_SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_3
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Settings Encryption Key (CRITICAL: NEVER CHANGE ONCE PRODUCTION IS SEEDED)
# Used to encrypt sensitive API keys and SMTP credentials inside MySQL.
SETTINGS_ENCRYPTION_KEY=GENERATE_64_CHAR_HEX_SECRET_ENCRYPTION

# ─── Domain URLs & CORS Origins ───────────────────────────────────────────────
FRONTEND_URL=https://tourvaa.com
API_BASE_URL=https://api.tourvaa.com
ALLOWED_ORIGINS=https://tourvaa.com,https://admin.tourvaa.com,https://portal.tourvaa.com
MOBILE_DEEP_LINK_URL=tourvaa://reset-password

# ─── Distributed Redis Cluster (REQUIRED FOR WEB_CONCURRENCY > 1) ─────────────
# Required for multi-pod / multi-worker distributed locking, rate limiting, and WebSockets.
REDIS_URL=redis://:CHANGE_TO_REDIS_PASSWORD@prod-redis.internal:6379/0
WEB_CONCURRENCY=4

# ─── Cloud Media Storage (Cloudinary Production) ──────────────────────────────
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@PROD_CLOUD_NAME
# Cloudinary remains only for authenticated private documents. Public
# tour/CMS media is stored under STORAGE_ROOT and served at /storage/.
# For Docker, bind-mount the host project folder instead of a named volume:
# /var/www/tourvaa/storage:/data/storage
CLOUDINARY_PUBLIC_ROOT=tourvaa/production/public
STORAGE_ROOT=/data/storage
PUBLIC_MEDIA_STORAGE=local
PUBLIC_MEDIA_BASE_URL=

# ─── Outbound SMTP Email ──────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_TO_PRODUCTION_SENDGRID_OR_SES_KEY
SMTP_FROM_NAME=Tourvaa Experience
SMTP_FROM_EMAIL=no-reply@tourvaa.com
SMTP_REPLY_TO=support@tourvaa.com
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# ─── Payment Gateways (Live Production) ────────────────────────────────────────
# Stripe Live Keys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal Live Keys
PAYPAL_CLIENT_ID=CHANGE_TO_PAYPAL_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_TO_PAYPAL_LIVE_CLIENT_SECRET
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=CHANGE_TO_PAYPAL_LIVE_WEBHOOK_ID

# ─── External Partner Integrations ───────────────────────────────────────────
# Viator Partner API (Day Tours & Experiences)
VIATOR_API_KEY=CHANGE_TO_VIATOR_PRODUCTION_KEY
VIATOR_PID=CHANGE_TO_VIATOR_PARTNER_ID
VIATOR_ENV=production
VIATOR_ENABLED=true
VIATOR_CAMPAIGN_PREFIX=tourvaa-prod

# Google OAuth (Production Client ID & Secret)
GOOGLE_CLIENT_ID=CHANGE_TO_GOOGLE_PROD_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_TO_GOOGLE_PROD_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.tourvaa.com/api/auth/google/callback

# ─── Web Push (VAPID Keys) ────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=CHANGE_TO_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY_FILE=/etc/tourvaa/secrets/vapid_private.pem
VAPID_MAILTO=mailto:ops@tourvaa.com
